              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", "p"}], "}"}]}], "]"}], ",", 
              "Mat"}], "]"}], ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"A", "=", 
