   RowBox[{
    RowBox[{"P01", "=", "P05"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Mat", "=", 
       RowBox[{"NMA", "[", 
        RowBox[{"SIG", ",", "p1", ",", "p2", ",", "p22", ",", "d"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"TT", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"TruncatedDistribution", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{
                   RowBox[{"ns", "+", "r", "-", "Ns"}], ",", 
                   RowBox[{"p1", "+", "p2", "+", "1"}]}], "]"}], "-", "1"}], 
                ",", 
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{"ns", ",", "r"}], "]"}], "+", "1"}]}], "}"}], ",", 
              RowBox[{"HypergeometricDistribution", "[", 
               RowBox[{"ns", ",", "r", ",", "Ns"}], "]"}]}], "]"}], ",", 
            "1"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "nv"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"p1", "+", "p2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"X", "=", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"MultinormalDistribution", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", "p"}], "}"}]}], "]"}], ",", 
              "Mat"}], "]"}], ",", 
            RowBox[{"TT", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"A", "=", 
          RowBox[{"Covariance", "[", "X", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"L1", "=", 
          RowBox[{
           RowBox[{"Det", "[", "A", "]"}], "/", 
