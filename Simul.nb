              "Mat"}], "]"}], ",", 
            RowBox[{"TT", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"A", "=", 
