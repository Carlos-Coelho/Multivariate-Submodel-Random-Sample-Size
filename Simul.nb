   RowBox[{
    RowBox[{"P05nr", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P01nr", "=", "P05nr"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Mat", "=", 
       RowBox[{"NMA", "[", 
        RowBox[{"SIG", ",", "p1", ",", "p2", ",", "p22", ",", "d"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"p1", "+", "p2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"X", "=", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"MultinormalDistribution", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", "p"}], "}"}]}], "]"}], ",", 
              "Mat"}], "]"}], ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"A", "=", 
          RowBox[{"Covariance", "[", "X", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"L1", "=", 
          RowBox[{
           RowBox[{"Det", "[", "A", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"Det", "[", 
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"p1", "+", "1"}], ")"}], ";;", "p"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"p1", "+", "1"}], ")"}], ";;", "p"}]}], "]"}], 
              "]"}], "]"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"L2", "=", 
          RowBox[{
           RowBox[{"Det", "[", 
            RowBox[{"A", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"1", ";;", 
                RowBox[{"(", 
                 RowBox[{"p", "-", "p22"}], ")"}]}], ",", 
               RowBox[{"1", ";;", 
                RowBox[{"(", 
                 RowBox[{"p", "-", "p22"}], ")"}]}]}], "]"}], "]"}], "]"}], 
           "/", 
           RowBox[{"(", 
            RowBox[{"Det", "[", 
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"p1", "+", "1"}], ")"}], ";;", 
                 RowBox[{"(", 
                  RowBox[{"p", "-", "p22"}], ")"}]}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"p1", "+", "1"}], ")"}], ";;", 
                 RowBox[{"(", 
                  RowBox[{"p", "-", "p22"}], ")"}]}]}], "]"}], "]"}], "]"}], 
            ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "=", 
          RowBox[{"L1", "/", "L2"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nv"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"P05nr", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"P05nr", ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"L", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "<", "q05nr"}]}]}], "]"}], "/", "nv"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"P01nr", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"P01nr", ",", 
