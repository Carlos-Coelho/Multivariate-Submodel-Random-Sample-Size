                   RowBox[{"ns", "+", "r", "-", "Ns"}], ",", 
                   RowBox[{"p1", "+", "p2", "+", "1"}]}], "]"}], "-", "1"}], 
                ",", 
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{"ns", ",", "r"}], "]"}], "+", "1"}]}], "}"}], ",", 
              RowBox[{"HypergeometricDistribution", "[", 
               RowBox[{"ns", ",", "r", ",", "Ns"}], "]"}]}], "]"}], ",", 
            "1"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "nv"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"p1", "+", "p2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "nv"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"X", "=", 
          RowBox[{"RandomReal", "[", 
