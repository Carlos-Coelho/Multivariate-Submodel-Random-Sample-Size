          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"L", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "<", "q01nr"}]}]}], "]"}], "/", "nv"}], "]"}]}], 
        "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "list"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
