  RowBox[{
   RowBox[{
    RowBox[{"list", "=", 
     RowBox[{"{", 
      RowBox[{
      "0", ",", ".1", ",", ".2", ",", ".3", ",", ".4", ",", ".5", ",", ".6", 
       ",", ".7", ",", ".8", ",", ".85", ",", ".875", ",", ".9", ",", ".925", 
       ",", ".95", ",", ".975", ",", "1"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p1", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p2", "=", "11"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p22", "=", "4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ns", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r", "=", "30"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ns", "=", "30"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nv", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P05", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P01", "=", "P05"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Mat", "=", 
       RowBox[{"NMA", "[", 
        RowBox[{"SIG", ",", "p1", ",", "p2", ",", "p22", ",", "d"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"TT", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"TruncatedDistribution", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", 
