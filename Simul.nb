          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"L", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "<", "q01"}]}]}], "]"}], "/", "nv"}], "]"}]}], 
        "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "list"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
