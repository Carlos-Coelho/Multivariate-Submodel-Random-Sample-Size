                  RowBox[{"p1", "+", "1"}], ")"}], ";;", "p"}]}], "]"}], 
              "]"}], "]"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"L2", "=", 
          RowBox[{
           RowBox[{"Det", "[", 
            RowBox[{"A", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"1", ";;", 
                RowBox[{"(", 
                 RowBox[{"p", "-", "p22"}], ")"}]}], ",", 
               RowBox[{"1", ";;", 
                RowBox[{"(", 
                 RowBox[{"p", "-", "p22"}], ")"}]}]}], "]"}], "]"}], "]"}], 
           "/", 
           RowBox[{"(", 
            RowBox[{"Det", "[", 
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"p1", "+", "1"}], ")"}], ";;", 
                 RowBox[{"(", 
                  RowBox[{"p", "-", "p22"}], ")"}]}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"p1", "+", "1"}], ")"}], ";;", 
                 RowBox[{"(", 
                  RowBox[{"p", "-", "p22"}], ")"}]}]}], "]"}], "]"}], "]"}], 
            ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "=", 
          RowBox[{"L1", "/", "L2"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nv"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"P05", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"P05", ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"L", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", "<", "q05"}]}]}], "]"}], "/", "nv"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"P01", "=", 
