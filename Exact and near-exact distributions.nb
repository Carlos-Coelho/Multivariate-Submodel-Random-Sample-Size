       RowBox[{"lsup", "=", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"vec", ",", 
           RowBox[{"-", "1"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xr", "=", 
        RowBox[{"Rat", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rj", "=", 
        RowBox[{"RjEven", "[", 
         RowBox[{"p1", ",", "p2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"weights", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vec", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<Poi\>\""}], ",", 
          RowBox[{"PMFPoi", "[", 
           RowBox[{
            RowBox[{"vec", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "i", ",", "p1", ",", "p2"}],
            "]"}], ",", 
          RowBox[{
           RowBox[{"vec", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<Bin\>\""}], ",", 
          RowBox[{"PMFBin", "[", 
           RowBox[{
            RowBox[{"vec", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"vec", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", "i", ",", "p1", ",", "p2"}],
            "]"}], ",", 
          RowBox[{
           RowBox[{"vec", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<HG\>\""}], ",", 
          RowBox[{"PMFHG", "[", 
           RowBox[{
            RowBox[{"vec", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"vec", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"vec", "[", 
             RowBox[{"[", "4", "]"}], "]"}], ",", "i", ",", "p1", ",", "p2"}],
            "]"}], ",", 
          RowBox[{
           RowBox[{"vec", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<NegBin\>\""}], 
          ",", 
          RowBox[{"PMFNegBin", "[", 
           RowBox[{
            RowBox[{"vec", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"vec", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", "i", ",", "p1", ",", "p2"}],
            "]"}], ",", 
          RowBox[{
           RowBox[{"vec", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "\[Equal]", "\"\<NegHG\>\""}], 
          ",", 
          RowBox[{"PMFNegHG", "[", 
           RowBox[{
            RowBox[{"vec", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"vec", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"vec", "[", 
             RowBox[{"[", "4", "]"}], "]"}], ",", "i", ",", "p1", ",", "p2"}],
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"1", "-", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"weights", "*", 
           RowBox[{"GIGcdf", "[", 
            RowBox[{"rj", ",", 
             RowBox[{"Lj", "[", 
              RowBox[{"p1", ",", "p2", ",", "i"}], "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"Log", "[", "xr", "]"}]}], ",", "prec"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "linf", ",", "lsup"}], "}"}]}], "]"}]}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["ExCDFOrigRSSEven",
       FontWeight->"Bold"], "::", "usage"}], "=", 
     "\"\<\!\(\*StyleBox[\"ExCDFOrigRSSEven\",FontWeight->\"Bold\"]\)[p1, p2, \
x, prec] computes the value for the exact CDF or p-value for the non-partial \
Lambda for the random sample size case for any of the sampling distributions \
in the paper, for even p1 or even p22;\narguments are (in this order):\n\
\!\(\*StyleBox[\"p1\",FontWeight->\"Bold\"]\) - the number of variables of \
the 1st set\n\!\(\*StyleBox[\"p2\",FontWeight->\"Bold\"]\) - the number of \
variables of the 2nd set\n\!\(\*StyleBox[\"x\",FontWeight->\"Bold\"]\) - the \
value of Lambda for which we want to compute the CDF or p-value\n\
\!\(\*StyleBox[\"prec\",FontWeight->\"Bold\"]\) - an optional argument \
setting the number of precision digits for the computation of the GNIG CDF \
(default value: 150)\>\""}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
